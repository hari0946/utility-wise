DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/utility_wise

# Comma-separated list of origins allowed to call this API, or * for any.
# For local testing with the HTML file opened directly, * is fine.
ALLOWED_ORIGINS=*

# Required to view submissions via GET /api/enquiries (send as header X-Admin-Key)
ADMIN_API_KEY=change-me

RATE_LIMIT_SECONDS=30

# Gmail API notification - sends from the account authorized via gmail_auth.py, to
# GMAIL_NOTIFY_TO, whenever a form is submitted. Leave GMAIL_NOTIFY_TO empty to disable.
# Get the three values below by running `python gmail_auth.py` once (see README).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_NOTIFY_TO=
