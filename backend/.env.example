DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/utility_wise

# Comma-separated list of origins allowed to call this API, or * for any.
# For local testing with the HTML file opened directly, * is fine.
ALLOWED_ORIGINS=*

# Required to view submissions via GET /api/enquiries (send as header X-Admin-Key)
ADMIN_API_KEY=change-me

RATE_LIMIT_SECONDS=30
